{
  "schemaVersion": 1,
  "id": "pvz-trainer-mod",
  "version": "1.0.0",
  "name": "PvZ Trainer Mod",
  "description": "修改器模组：常驻可拖动的原生悬浮按钮，点击展开标签页对话框（无限阳光/免费种植/自动收集/暂停出怪与出怪推进、一键清场等）。主菜单 X+C 或 ModMenu 配置入口打开设置。",
  "authors": [
    "MoeLuoYu"
  ],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "main": [
      "cn.enaium.fabricpvz.trainermod.TrainerMod"
    ],
    "modmenu": [
      "cn.enaium.fabricpvz.trainermod.TrainerModMenu"
    ]
  },
  "mixins": [
    "trainermod.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.0",
    "fabric-api": ">=1.1.0",
    "pvz-portable": "*"
  }
}
